{
	"version": "0.996",
	
	"drive": ["/home/pi/Desktop/videos/"],
	"name": "Raspberry Pi TV Station",
	"insert_commercials": true,
	"max_play_attempts": 1,
	"commercials_per_break": 1,
	"commercials_fill_time_multiplier": 50,
	"commercials_offset_time": -15,
	"time_test":  null,
	"time_test_example": "Jul 05 2026 12:30AM",
	"debug": false,
	"debug positon": 9999999,
	"report_data": true,
	"daily reboot": true,
	"random video on first play": true,
	"player_settings": ["--no-osd", "--blank"],
	"cache_path": "/home/pi/Desktop/cache",
	"workers": null,

	"channels":	{
				"error": "Error",
				"names": [null,  "Error"],
				"file": "/home/pi/Desktop/.channel"
			},

	"web-ui": {
			"show_type_colors": { "TV Show Examples": "00E1FF", "Station": "14A800" },
			"commercial_type_colors": { "commercials": "FF00FF" },
			"database_info": { "host": "localhost", "username": "pi", "password": "raspberry", "database_name": "shows" },
			"theme": "modern"
		  },

	"youtube-dl":	{
				"command" : "yt-dlp",
				"update_command": "pip install -U yt-dlp"
			},

	"vars": {
			
		},

	"times": [
		{
			"name": ["%D[1]%/station"],
			"type": "video",
			"note": "if no other time has been triggered, play the 'technical difficulties' video because something went wrong somewhere"
		},
		{
			"name": ["%D[1]%/examples/video"],
			"type": "video",
			"between": { "times": [ ["08:00PM", "08:30PM"] ] },
			"note": "this example videos show will only play between 08:00PM and 08:30PM everyday. Remove the 'between' parameter or change the time to trigger."
		}
	],


	"commercial_times": [
		{
			"name": ["%D[1]%/examples/commercials"],
			"type": "video",
			"note": "this is a catch-all"
		}
	]
}